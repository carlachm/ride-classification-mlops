# Copy to .env (never commit .env!):  cp .env.example .env

# --- MinIO (S3) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MLFLOW_BUCKET=mlflow
DVC_BUCKET=dvc

# DVC talks to MinIO directly (S3 API): same values as above (used by `make data` / `make push`)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123

# --- PostgreSQL (MLflow backend store) ---
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow
POSTGRES_DB=mlflow

# --- Used by the Python code on your machine ---
# macOS: AirPlay Receiver already uses port 5000, so MLflow is exposed on 5050
MLFLOW_PORT=5050
MLFLOW_TRACKING_URI=http://localhost:5050
# Download model files THROUGH the MLflow server (MinIO's address minio:9000 only exists inside Docker)
MLFLOW_ENABLE_PROXY_MULTIPART_DOWNLOAD=false
