# Secrets
.env

# Data (versioned with DVC, not Git)
/data/raw/*
!/data/raw/.gitkeep
!/data/raw/*.dvc
!/data/raw/.gitignore
/data/processed/
/data/monitoring/
/data/feedback/

# Runtime outputs of the API and the monitoring (never committed)
/logs/
/reports/

# MLflow local store (when no server is used)
mlruns/
mlartifacts/
mlflow.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# Tests / tools
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE / OS
.vscode/
.idea/
.DS_Store
.ipynb_checkpoints/

# CI reports
coverage.xml
junit.xml
